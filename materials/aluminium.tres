[sub_resource type="Shader" id="1"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;
uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color;
uniform float specular;
uniform float metallic;
uniform float roughness : hint_range(0, 1);
uniform float point_size : hint_range(0, 128);
uniform sampler2D texture_normal;
uniform float normal_scale : hint_range(-16, 16);
uniform float anisotropy_ratio : hint_range(0, 256);
uniform sampler2D texture_flowmap;
uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;
uniform bool use_instance_color = false;
uniform vec4 band_color1 : source_color;
uniform vec4 band_color2 : source_color;
uniform vec4 band_color3 : source_color;
uniform vec4 band_color4 : source_color;
uniform float band_count = 4.0;
uniform vec2 world_uv_scale = vec2(0.05, 0.05);
uniform vec2 world_uv_offset = vec2(0.0, 0.0);
uniform float band_world_scale = 0.05;

varying vec4 selecting_mask;
varying vec3 world_pos;
varying vec3 n_world;
varying float local_y;

void vertex() {
	selecting_mask = INSTANCE_CUSTOM;
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	local_y = VERTEX.y; // mesh-local height, moves with the tile
	// Baked mesh normals are now correct (fixed cairo_enabled.tres), so the
	// triplanar blend, lighting, and reflections can trust them.
	n_world = normalize(MODEL_NORMAL_MATRIX * NORMAL);
	// World-aligned tangent frame (top face -> world +X/-Z, walls ->
	// horizontal/up) so the normal map and anisotropy don't rotate with the
	// tile's 0/90/180/270° Y-rotation.
	vec3 wt;
	vec3 wb;
	if (abs(n_world.y) > 0.9) {
		wt = vec3(1.0, 0.0, 0.0);
		wb = vec3(0.0, 0.0, -1.0);
	} else {
		wt = normalize(cross(vec3(0.0, 1.0, 0.0), n_world));
		wb = cross(n_world, wt);
	}
	mat3 inv_rot = transpose(mat3(MODEL_MATRIX)); // tiles are pure rotations -> inverse
	TANGENT = normalize(inv_rot * wt);
	BINORMAL = normalize(inv_rot * wb);
}

void fragment() {
	vec3 n = normalize(n_world);
	// Triplanar world-space UV so grain/reflections align across all four
	// orientations and stay continuous across tile edges. Walls use the
	// tile-local height (local_y) for their vertical axis so the texture
	// moves with the tile as it falls/raises.
	vec3 abn = abs(n);
	abn = abn * abn;
	vec3 blend = abn / (abn.x + abn.y + abn.z);
	vec2 base_uv = (vec2(world_pos.z, local_y) * blend.x
	              + vec2(world_pos.x, world_pos.z) * blend.y
	              + vec2(world_pos.x, local_y) * blend.z);
	base_uv = base_uv * world_uv_scale + world_uv_offset;
	vec4 albedo_tex = texture(texture_albedo, base_uv);
	ALBEDO = albedo.rgb * albedo_tex.rgb;
	// 45° diagonal bands from combined world axes
	// Color cycle is driven by per-instance selecting_mask (set from selected_by)
	float d = (world_pos.x + world_pos.z) * band_world_scale;
	float band_id = floor(d * band_count);
	float active = step(0.01, selecting_mask.r) + step(0.01, selecting_mask.g) + step(0.01, selecting_mask.b) + step(0.01, selecting_mask.a);
	float col_idx = mod(band_id, max(active, 1.0));
	vec4 band_tint = vec4(1.0);
	float seen = 0.0;
	seen += step(0.01, selecting_mask.r);
	if (col_idx + 0.5 < seen) { band_tint = band_color1; }
	else {
		seen += step(0.01, selecting_mask.g);
		if (col_idx + 0.5 < seen) { band_tint = band_color2; }
		else {
			seen += step(0.01, selecting_mask.b);
			if (col_idx + 0.5 < seen) { band_tint = band_color3; }
			else {
				seen += step(0.01, selecting_mask.a);
				if (col_idx + 0.5 < seen) { band_tint = band_color4; }
			}
		}
	}
	ALBEDO *= band_tint.rgb;
	METALLIC = metallic;
	ROUGHNESS = roughness;
	SPECULAR = specular;
	NORMAL_MAP = texture(texture_normal, base_uv).rgb;
	NORMAL_MAP_DEPTH = normal_scale;
	// emission: COLOR.rgb = emission color, COLOR.a = emission intensity
	if (use_instance_color) {
		EMISSION = COLOR.rgb * COLOR.a;
	}
	vec3 anisotropy_tex = texture(texture_flowmap, base_uv).rga;
	ANISOTROPY = anisotropy_ratio * anisotropy_tex.b;
	ANISOTROPY_FLOW = anisotropy_tex.rg * 2.0 - 1.0;
}
"

[resource]
render_priority = 0
shader = SubResource("1")
shader_parameter/albedo = Color(1, 1, 1, 1)
shader_parameter/texture_albedo = ExtResource("3")
shader_parameter/specular = 0.5
shader_parameter/metallic = 0.75
shader_parameter/roughness = 0.5
shader_parameter/point_size = 1.0
shader_parameter/normal_scale = 0.4
shader_parameter/anisotropy_ratio = 0.2
shader_parameter/texture_flowmap = ExtResource("2")
shader_parameter/uv1_scale = Vector3(1, 1, 1)
shader_parameter/uv1_offset = Vector3(0, 0, 0)
shader_parameter/uv2_scale = Vector3(1, 1, 1)
shader_parameter/uv2_offset = Vector3(0, 0, 0)
shader_parameter/use_instance_color = false
shader_parameter/band_color1 = Color(1, 0, 0, 1)
shader_parameter/band_color2 = Color(0, 1, 0, 1)
shader_parameter/band_color3 = Color(1, 1, 0, 1)
shader_parameter/band_color4 = Color(1, 0.27, 0, 1)
shader_parameter/band_count = 4.0
shader_parameter/world_uv_scale = Vector2(0.05, 0.05)
shader_parameter/world_uv_offset = Vector2(0, 0)
shader_parameter/band_world_scale = 0.05
