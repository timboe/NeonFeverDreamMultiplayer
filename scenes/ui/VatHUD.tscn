text = "⚡ Not empowered"
horizontal_alignment = 1
autowrap_mode = 3

[node name="EnergyRow" type="HBoxContainer" parent="Window/VBox"]
layout_mode = 2

[node name="EnergyName" type="Label" parent="Window/VBox/EnergyRow"]
