[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/VatHUD.gd" id="1_vat"]
[ext_resource type="Theme" path="res://themes/terminal_ui.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://images/cursor.png" id="cursor_png"]
[ext_resource type="Script" path="res://scripts/ui/TerminalCursor.gd" id="cursor_script"]

[node name="Root" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_vat")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 1)

[node name="Window" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -228.0
offset_top = -228.0
offset_right = 228.0
offset_bottom = 228.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Window"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Window/VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="Window/VBox/Header"]
